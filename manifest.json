{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.8.0",
  "default_locale": "en",
  "minimum_chrome_version": "119",
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://github.com/ari92p/slate",
  "permissions": [
    "history",
    "storage",
    "alarms",
    "contextMenus",
    "unlimitedStorage"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
