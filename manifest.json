{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.9.4",
  "default_locale": "en",
  "minimum_chrome_version": "119",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/slate-16.png",
    "32": "icons/slate-32.png",
    "48": "icons/slate-48.png",
    "128": "icons/slate-128.png"
  },
  "homepage_url": "https://github.com/ari92p/slate",
  "permissions": [
    "history",
    "storage",
    "alarms",
    "contextMenus",
    "unlimitedStorage"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/idle-16.png",
      "32": "icons/idle-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
